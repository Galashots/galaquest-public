%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8c0cb7f024cb8c4f8c505dc3e0b2386, type: 3}
  m_Name: GearFitFixture_Shoulder
  m_EditorClassIdentifier: GalaQuest.Gear.Editor::GalaQuest.Gear.Editor.GearFitFixtureDefinition
  contractId: GQ_HERO_V1_GEAR_DATUM
  contractVersion: V0
  coordinateConvention: +X = wearer RIGHT; +Y = wearer UP; +Z = wearer FORWARD; 1
    Unity unit = 1 metre; Unity left-handed, so Cross(right, up) == forward.
  metresPerUnityUnit: 1
  slot: 1
  displayName: Shoulder fit contract
  frames:
  - frameId: GQ_SHOULDER_L_FRAME
    side: 1
    anchorBone: LeftArm
    originInAnchor: {x: 0, y: 0, z: 0}
    rightAxisInAnchor: {x: -0.024667542, y: -0.35618314, z: 0.93409055}
    upAxisInAnchor: {x: -0.99928284, y: 0.035637468, z: -0.012800157}
    forwardAxisInAnchor: {x: -0.028729262, y: -0.9337364, z: -0.3568067}
    provenance: 1
    provenanceNote: Canonical wearer axes inverse-transformed through the LeftArm
      bind pose, so the frame is independent of that bone's imported roll. Origin
      is the LeftArm joint. Side Left means outboard is -X; the axes themselves stay
      canonical, so +X is still wearer right on this frame.
  - frameId: GQ_SHOULDER_R_FRAME
    side: 2
    anchorBone: RightArm
    originInAnchor: {x: 0, y: 0, z: 0}
    rightAxisInAnchor: {x: 0.3903559, y: 0.49624467, z: -0.7754763}
    upAxisInAnchor: {x: 0.340276, y: -0.86042434, z: -0.37931812}
    forwardAxisInAnchor: {x: -0.85547316, y: -0.11580685, z: -0.504732}
    provenance: 1
    provenanceNote: Canonical wearer axes inverse-transformed through the RightArm
      bind pose, so the frame is independent of that bone's imported roll. Origin
      is the RightArm joint. Side Right means outboard is +X.
  datums:
  - datumId: FIT_SHOULDER_CUP_L
    displayName: Shoulder cup L
    role: 1
    frameId: GQ_SHOULDER_L_FRAME
    localCenter: {x: -0.02886266, y: -0, z: -0}
    localSize: {x: 0.19241773, y: 0.19241773, z: 0.19241773}
    provenance: 3
    sourceJoints:
    - LeftArm
    provenanceNote: Measured deltoid diameter 0.1624 m -- the 0.9500 percentile radius
      of LeftArm-dominated vertices about the upper-arm axis over the top 35% of
      the bone -- plus the authored radial clearance 0.0150 m.
  - datumId: WARN_TORSO_SIDE_L
    displayName: Torso side limit L
    role: 3
    frameId: GQ_SHOULDER_L_FRAME
    localCenter: {x: 0.050980784, y: -0.00000013866544, z: -0.0044321436}
    localSize: {x: 0.03, y: 0.19241773, z: 0.19361019}
    provenance: 3
    sourceJoints:
    - Spine02
    - LeftArm
    provenanceNote: The wearer-left flank of the measured torso (0.2044 m wide).
      A pauldron reaching past this intersects the body; that is reported, never
      auto-corrected.
  - datumId: REF_ARM_SWING_L
    displayName: Arm swing room L
    role: 4
    frameId: GQ_SHOULDER_L_FRAME
    localCenter: {x: -0.038483545, y: -0.17317595, z: 0}
    localSize: {x: 0.17317595, y: 0.30786836, z: 0.17317595}
    provenance: 2
    sourceJoints: []
    provenanceNote: 'Authored context for the eye: roughly where the upper arm travels.
      Carries no machine authority and is not swept against animation in V0.'
  - datumId: FIT_SHOULDER_CUP_R
    displayName: Shoulder cup R
    role: 1
    frameId: GQ_SHOULDER_R_FRAME
    localCenter: {x: 0.02886266, y: 0, z: 0}
    localSize: {x: 0.19241773, y: 0.19241773, z: 0.19241773}
    provenance: 3
    sourceJoints:
    - RightArm
    provenanceNote: Measured deltoid diameter 0.1624 m -- the 0.9500 percentile radius
      of RightArm-dominated vertices about the upper-arm axis over the top 35% of
      the bone -- plus the authored radial clearance 0.0150 m.
  - datumId: WARN_TORSO_SIDE_R
    displayName: Torso side limit R
    role: 3
    frameId: GQ_SHOULDER_R_FRAME
    localCenter: {x: -0.043438185, y: -0.00000009193198, z: -0.050425205}
    localSize: {x: 0.03, y: 0.19241773, z: 0.19361019}
    provenance: 3
    sourceJoints:
    - Spine02
    - RightArm
    provenanceNote: The wearer-right flank of the measured torso (0.2044 m wide).
      A pauldron reaching past this intersects the body; that is reported, never
      auto-corrected.
  - datumId: REF_ARM_SWING_R
    displayName: Arm swing room R
    role: 4
    frameId: GQ_SHOULDER_R_FRAME
    localCenter: {x: 0.038483545, y: -0.17317595, z: 0}
    localSize: {x: 0.17317595, y: 0.30786836, z: 0.17317595}
    provenance: 2
    sourceJoints: []
    provenanceNote: 'Authored context for the eye: roughly where the upper arm travels.
      Carries no machine authority and is not swept against animation in V0.'
  primaryMeasurement:
    metric: 2
    sourceDatumId: FIT_SHOULDER_CUP_L
    axis: 0
    referenceValueMetres: 0.19241773
    provenance: 3
    provenanceNote: A pauldron is uniformly scaled so its wearer-width matches the
      shoulder cup. The left cup is the reference and the right frame is its mirror,
      so a single mesh normalizes identically for both shoulders.
  secondaryProportionChecks:
  - checkId: shoulder_width_to_height
    numeratorAxis: 0
    denominatorAxis: 1
    rejectBelow: 0.5
    warnBelow: 0.7
    warnAbove: 2.2
    rejectAbove: 3
    provenance: 2
    provenanceNote: A pauldron may legitimately be wide and shallow, so the upper
      band is generous; an extremely tall one is a spaulder stack that needs a human
      decision.
  - checkId: shoulder_width_to_depth
    numeratorAxis: 0
    denominatorAxis: 2
    rejectBelow: 0.5
    warnBelow: 0.65
    warnAbove: 1.7
    rejectAbove: 2.3
    provenance: 2
    provenanceNote: Guards against a pauldron that is a flat plate with no front-to-back
      body.
  anatomyHideIntent: 
  measuredFromPrefabPath: Assets/GalaQuest/Gear/Prefabs/GQ_HERO_V1.prefab
  measuredFromSourceRepoPath: public/assets/hero/hero_lod1_ironwood_atlas.glb
  measuredFromSourceSha256: 082fc24b8fe181a6b428a3226471e56cafbb71edd6cacbfdcfd82651dfa61679
