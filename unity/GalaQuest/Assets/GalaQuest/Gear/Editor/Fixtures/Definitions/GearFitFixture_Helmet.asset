%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8c0cb7f024cb8c4f8c505dc3e0b2386, type: 3}
  m_Name: GearFitFixture_Helmet
  m_EditorClassIdentifier: GalaQuest.Gear.Editor::GalaQuest.Gear.Editor.GearFitFixtureDefinition
  contractId: GQ_HERO_V1_GEAR_DATUM
  contractVersion: V0
  coordinateConvention: +X = wearer RIGHT; +Y = wearer UP; +Z = wearer FORWARD; 1
    Unity unit = 1 metre; Unity left-handed, so Cross(right, up) == forward.
  metresPerUnityUnit: 1
  slot: 0
  displayName: Helmet fit contract
  frames:
  - frameId: GQ_HEAD_FRAME
    side: 0
    anchorBone: Head
    originInAnchor: {x: 0, y: 0, z: 0}
    rightAxisInAnchor: {x: 0.9984984, y: 0.012241283, z: -0.05339502}
    upAxisInAnchor: {x: -0.02194661, y: 0.98246175, z: -0.18516822}
    forwardAxisInAnchor: {x: 0.05019195, y: 0.186062, z: 0.9812552}
    provenance: 1
    provenanceNote: Canonical wearer axes inverse-transformed through the Head bind
      pose, so the frame is independent of that bone's imported roll. Origin is the
      Head joint itself, which is the functional seat of headgear.
  datums:
  - datumId: FIT_CROWN
    displayName: Crown
    role: 1
    frameId: GQ_HEAD_FRAME
    localCenter: {x: 0, y: 0.3860942, z: -0.04374151}
    localSize: {x: 0.3245963, y: 0.03, z: 0.3267033}
    provenance: 1
    sourceJoints:
    - Head
    - head_end
    provenanceNote: 'The functional top of the HEAD, taken from the rig head_end
      helper joint. This is NOT the top of a helmet mesh: a helmet may carry horns
      or a plume above it, which belong to REF_DECOR_HEADROOM.'
  - datumId: FIT_HEAD_CAVITY
    displayName: Head cavity
    role: 1
    frameId: GQ_HEAD_FRAME
    localCenter: {x: 0, y: 0.1930471, z: 0}
    localSize: {x: 0.34859627, y: 0.3860942, z: 0.3507033}
    provenance: 3
    sourceJoints:
    - Head
    - head_end
    provenanceNote: Measured head width 0.3246 m and depth 0.3267 m from Head-dominated
      vertices at the 0.9500 percentile, plus the authored radial clearance 0.0120
      m on each side. The percentile rather than the maximum keeps hair spikes out
      of the functional width.
  - datumId: FIT_BROW
    displayName: Brow line
    role: 1
    frameId: GQ_HEAD_FRAME
    localCenter: {x: 0, y: 0.21157962, z: 0.05978658}
    localSize: {x: 0.3245963, y: 0.03, z: 0.3507033}
    provenance: 2
    sourceJoints: []
    provenanceNote: 'Authored, not measured: the Hero eyes are painted into the atlas
      and have no geometry to measure. Placed at 0.5480 of the measured head height,
      the same convention HeadFitProxy uses.'
  - datumId: KEEP_FACE_OPENING
    displayName: Face opening
    role: 2
    frameId: GQ_HEAD_FRAME
    localCenter: {x: 0, y: 0.15868472, z: 0.11957316}
    localSize: {x: 0.2012497, y: 0.17374238, z: 0.03}
    provenance: 2
    sourceJoints: []
    provenanceNote: 'Authored keep-clear: the face must stay readable. Sized as a
      fraction of the measured head, positioned at the rig headfront helper depth.'
  - datumId: REF_WIDTH_LEFT
    displayName: Left width reference
    role: 4
    frameId: GQ_HEAD_FRAME
    localCenter: {x: -0.16229814, y: 0.1930471, z: 0}
    localSize: {x: 0.03, y: 0.1930471, z: 0.16335166}
    provenance: 1
    sourceJoints:
    - Head
    provenanceNote: Wearer LEFT edge of the measured head width. Its centre is on
      -X by construction, which is what makes a left/right reversal detectable rather
      than invisible.
  - datumId: REF_WIDTH_RIGHT
    displayName: Right width reference
    role: 4
    frameId: GQ_HEAD_FRAME
    localCenter: {x: 0.16229814, y: 0.1930471, z: 0}
    localSize: {x: 0.03, y: 0.1930471, z: 0.16335166}
    provenance: 1
    sourceJoints:
    - Head
    provenanceNote: Wearer RIGHT edge of the measured head width. Its centre is on
      +X by construction.
  - datumId: REF_DECOR_HEADROOM
    displayName: Decoration headroom
    role: 5
    frameId: GQ_HEAD_FRAME
    localCenter: {x: 0, y: 0.47609422, z: -0.04374151}
    localSize: {x: 0.34859627, y: 0.18, z: 0.3507033}
    provenance: 2
    sourceJoints: []
    provenanceNote: 'Room above FIT_CROWN where horns, plumes and crests may live.
      Explicitly NOT a fit reference: geometry in here must never drive normalization
      or be mistaken for the crown.'
  primaryMeasurement:
    metric: 1
    sourceDatumId: FIT_HEAD_CAVITY
    axis: 0
    referenceValueMetres: 0.34859627
    provenance: 3
    provenanceNote: A helmet is uniformly scaled so its wearer-width matches the
      head cavity width. Width is chosen over height because a helmet may legitimately
      be tall (crest, plume) but may not be wider than the head it has to sit on.
  secondaryProportionChecks:
  - checkId: helmet_width_to_height
    numeratorAxis: 0
    denominatorAxis: 1
    rejectBelow: 0.45
    warnBelow: 0.62
    warnAbove: 1.35
    rejectAbove: 1.8
    provenance: 2
    provenanceNote: After uniform scaling, a helmet much taller than it is wide is
      a crest that was not declared, and one much wider is a squashed import. Report
      it; do NOT squash the asset back into range.
  - checkId: helmet_width_to_depth
    numeratorAxis: 0
    denominatorAxis: 2
    rejectBelow: 0.55
    warnBelow: 0.7
    warnAbove: 1.3
    rejectAbove: 1.7
    provenance: 2
    provenanceNote: Guards against a helmet that fits across the head but is flat
      front-to-back.
  anatomyHideIntent: 0000000001000000
  measuredFromPrefabPath: Assets/GalaQuest/Gear/Prefabs/GQ_HERO_V1.prefab
  measuredFromSourceRepoPath: public/assets/hero/hero_lod1_ironwood_atlas.glb
  measuredFromSourceSha256: 082fc24b8fe181a6b428a3226471e56cafbb71edd6cacbfdcfd82651dfa61679
  seatBindings:
  - socketId: head
    frameId: GQ_HEAD_FRAME
    seatingDatumId: FIT_HEAD_CAVITY
