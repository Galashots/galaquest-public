# Brainstorm companion server state and generated mockups
.superpowers/

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*

# Build output
dist/
build/

# Transient artifacts: references under evaluation, captures, teardown scratch
tmp/

# Decision lab third-party inputs: a vendored three.js and copies of the CC0 anchor models.
# Both are regenerable — see tools/decision-lab/README.md. anchors.json is NOT ignored: it is the
# record of the numbers the owner was shown when he made the decision.
tools/decision-lab/public/vendor/
tools/decision-lab/public/assets/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# Vite / dev server logs
vite-*.log

# Blender: bytecode caches and .blend save backups, both regenerated by the build
__pycache__/
*.blend1

# Foundry candidate render sweeps. validate_candidate.py writes 72 images per candidate (~10 MB),
# and the rebuild is deterministic, so they regenerate byte-for-byte rather than needing archiving.
# The compact evidence boards built from them ARE committed -- they are the durable summary.
foundry/candidates/*/renders/

# Scratch space for large third-party assets under evaluation (Meshy exports, etc).
# Never committed: a single rigged export is ~25 MB and arrives three to a zip.
.local/

# The children's save (net/rewardStore.mjs). data/ itself is tracked -- see data/README.md -- but
# the actual SQLite files and their -wal/-shm sidecars are not, same as any other local database.
data/*.db*

# Claude Code agent worktrees (ephemeral, session-local)
.claude/worktrees/
