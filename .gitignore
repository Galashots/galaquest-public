# Brainstorm companion server state and generated mockups
.superpowers/

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*

# Build output
dist/
build/

# Transient artifacts: references under evaluation, captures, teardown scratch
tmp/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# Vite / dev server logs
vite-*.log

# Blender: bytecode caches and .blend save backups, both regenerated by the build
__pycache__/
*.blend1

# Scratch space for large third-party assets under evaluation (Meshy exports, etc).
# Never committed: a single rigged export is ~25 MB and arrives three to a zip.
.local/

# The children's save (net/rewardStore.mjs). data/ itself is tracked -- see data/README.md -- but
# the actual SQLite files and their -wal/-shm sidecars are not, same as any other local database.
data/*.db*

# Claude Code agent worktrees (ephemeral, session-local)
.claude/worktrees/

# Unity project-generated state; keep the project, settings, assets, scripts and tests tracked.
unity/GalaQuest/Library/
unity/GalaQuest/Logs/
unity/GalaQuest/Temp/
unity/GalaQuest/UserSettings/
unity/GalaQuest/obj/
unity/GalaQuest/Builds/
unity/GalaQuest/MemoryCaptures/
unity/GalaQuest/Recordings/
unity/GalaQuest/*.csproj
unity/GalaQuest/*.sln

# Unity Test Framework performance-run artifacts. Generated into Assets/Resources by a test run,
# never authored, and not part of the project.
unity/GalaQuest/Assets/Resources/PerformanceTestRun*.json
unity/GalaQuest/Assets/Resources/PerformanceTestRun*.json.meta
