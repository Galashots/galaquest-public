{
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "sessionId", "seq", "mode", "request"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "seq": { "type": "integer", "minimum": 1 },
    "mode": {
      "type": "string",
      "enum": ["ping", "studioCapture", "studioState", "studioFitEnvelope"]
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!-)(?!.*(?:\\.\\.|@\\{|\\\\))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "request": { "type": "object" }
  },
  "if": { "properties": { "mode": { "const": "ping" } } },
  "then": {
    "properties": {
      "request": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
    }
  },
  "else": {
    "if": { "properties": { "mode": { "const": "studioCapture" } } },
    "then": {
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["character", "animation", "views"],
          "properties": {
            "character": { "type": "string", "enum": ["hero"] },
            "animation": { "type": "string", "minLength": 1, "maxLength": 100 },
            "timeSeconds": { "type": "number", "minimum": 0 },
            "lightingMode": { "type": "string", "enum": ["game", "diagnostic"] },
            "loadout": {
              "type": "string",
              "enum": ["shipping", "shipping-sword-only", "candidate-with-lantern", "candidate-wildwood-blade"]
            },
            "viewportPreset": { "type": "string", "enum": ["portrait", "landscape"] },
            "overlay": { "type": "string", "enum": ["none", "grip", "shield"] },
            "includeMeasurements": { "type": "boolean" },
            "tuningOverride": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target"],
              "properties": {
                "target": { "type": "string", "enum": ["sword", "shield"] },
                "positionDelta": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "type": "number", "minimum": -0.3, "maximum": 0.3 }
                },
                "rotationDeltaDeg": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "type": "number", "minimum": -90, "maximum": 90 }
                },
                "scaleDelta": { "type": "number", "minimum": -0.5, "maximum": 0.5 }
              }
            },
            "views": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scale", "bearing"],
                "properties": {
                  "scale": { "type": "string", "enum": ["gameplay", "inspection", "closeup"] },
                  "bearing": {
                    "type": "string",
                    "enum": ["front", "three-quarter", "side", "rear-three-quarter", "back", "opposite-side"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "else": {
      "if": { "properties": { "mode": { "const": "studioState" } } },
      "then": {
        "properties": {
          "request": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
        }
      },
      "else": {
        "if": { "properties": { "mode": { "const": "studioFitEnvelope" } } },
        "then": {
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clips"],
              "properties": {
                "clips": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": { "type": "string", "minLength": 1, "maxLength": 100 }
                },
                "samples": { "type": "integer", "minimum": 1, "maximum": 60 },
                "loadout": {
                  "type": "string",
                  "enum": ["shipping", "shipping-sword-only", "candidate-with-lantern", "candidate-wildwood-blade"]
                },
                "tuningOverride": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["target"],
                  "properties": {
                    "target": { "type": "string", "enum": ["sword", "shield"] },
                    "positionDelta": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": { "type": "number", "minimum": -0.3, "maximum": 0.3 }
                    },
                    "rotationDeltaDeg": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": { "type": "number", "minimum": -90, "maximum": 90 }
                    },
                    "scaleDelta": { "type": "number", "minimum": -0.5, "maximum": 0.5 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
